rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true;
    }

    // NOTA: os documentos de /admins/{adminId} devem usar o UID do Firebase
    // Authentication como ID do documento, para que get() acima funcione
    // sem uma consulta adicional. Ajuste o app para gravar assim ao criar
    // um admin (doc(db, "admins", user.uid)).

    // ---- admins ----
    // Ninguém lê/escreve admins pelo client; apenas leitura do próprio
    // documento para checagem de permissão, tudo o mais via console/admin SDK.
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // ---- employees ----
    // Público lê apenas para exibir dados; escrita somente admin.
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- weeks ----
    match /weeks/{weekId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- weeklyHistory ----
    match /weeklyHistory/{historyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- highlights ----
    match /highlights/{highlightId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- imports (logs de importação) ----
    match /imports/{importId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- logs administrativos ----
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---- config ----
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
